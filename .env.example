# Production Environment Variable Configuration Template
# Copy to .env in production deployment

DEBUG=False
SECRET_KEY=change-this-to-a-secure-random-50-character-string-in-production!
ALLOWED_HOSTS=.ourapp.com,localhost,127.0.0.1

# Database Configuration
POSTGRES_DB=studenterp_prod
POSTGRES_USER=studenterp_user
POSTGRES_PASSWORD=secure_postgres_password_here

# Cache & Task Queue Configuration
REDIS_URL=redis://redis:6379/0

# Production Security
SECURE_HSTS_SECONDS=31536000
